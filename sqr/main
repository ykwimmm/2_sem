#include <iostream>
#include <iomanip>
#include "Queue.h"
#include <clocale>

using namespace std;

/**
* @brief Точка входа в программу
* @return 0, если программа выполнена успешно
*/
int main() {

    setlocale(LC_ALL, "Russian");

    cout << "ДЕМОНСТРАЦИЯ РАБОТЫ ОЧЕРЕДИ" << endl << endl;

    cout << "1. Создание очереди через список инициализации:" << endl;
    Queue queue1 = { 10, 20, 30, 40, 50 };
    cout << "queue1 = " << queue1 << endl;
    cout << "Размер: " << queue1.getSize() << endl;
    cout << "Пуста? " << (queue1.isEmpty() ? "Да" : "Нет") << endl;
    cout << endl;

    cout << "2. Добавление элементов в очередь:" << endl;
    queue1.enqueue(60);
    cout << "После queue1.enqueue(60): " << queue1 << endl;
    queue1 >>= 70;  
    cout << "После queue1 >>= 70: " << queue1 << endl;
    cout << endl;

    cout << "3. Просмотр первого элемента:" << endl;
    cout << "peek(): " << queue1.peek() << endl;
    cout << "Очередь после peek(): " << queue1 << endl;
    cout << endl;

    cout << "4. Извлечение элементов из очереди:" << endl;
    int value;
    queue1 <<= value;  
    cout << "Извлечено через оператор <<=: " << value << endl;
    cout << "Очередь после извлечения: " << queue1 << endl;

    cout << "Извлечено через dequeue(): " << queue1.dequeue() << endl;
    cout << "Очередь после dequeue(): " << queue1 << endl;
    cout << endl;

    cout << "5. Копирование очереди:" << endl;
    Queue queue2(queue1);  
    cout << "queue2 (копия queue1): " << queue2 << endl;

    Queue queue3;
    queue3 = queue1;  
    cout << "queue3 = queue1: " << queue3 << endl;
    cout << endl;

    cout << "6. Перемещение очереди:" << endl;
    Queue queue4(move(queue2));  
    cout << "queue4 (перемещение из queue2): " << queue4 << endl;
    cout << "queue2 после перемещения: " << queue2 << endl;
    cout << "Размер queue2: " << queue2.getSize() << endl;
    cout << endl;

    cout << "7. Работа с пустой очередью:" << endl;
    Queue emptyQueue;
    cout << "Пустая очередь: " << emptyQueue << endl;
    cout << "Пуста? " << (emptyQueue.isEmpty() ? "Да" : "Нет") << endl;
    cout << endl;

    cout << "8. Создание и модификация новой очереди:" << endl;
    Queue queue5 = { 1, 2, 3 };
    cout << "Исходная очередь: " << queue5 << endl;
    queue5.enqueue(4);
    queue5.enqueue(5);
    queue5.enqueue(6);
    cout << "После добавления 4, 5, 6: " << queue5 << endl;

    int v1 = 0, v2 = 0;
    queue5 <<= v1 <<= v2;
    cout << "Извлечено v1=" << v1 << ", v2=" << v2 << endl;
    cout << "Очередь после извлечения двух элементов: " << queue5 << endl;
    cout << endl;

    cout << "9. Демонстрация работы с очередью из 10 элементов:" << endl;
    Queue largeQueue;
    cout << "Добавление элементов 1..10:" << endl;
    for (int i = 1; i <= 10; ++i) 
    {
        largeQueue.enqueue(i);
    }
    cout << "largeQueue = " << largeQueue << endl;

    cout << "Последовательное извлечение элементов:" << endl;
    while (!largeQueue.isEmpty()) 
    {
        cout << largeQueue.dequeue() << " ";
    }
    cout << endl;
    cout << "Очередь после извлечения всех элементов: " << largeQueue << endl;
    cout << endl;

    cout << "10. Проверка обработки ошибок:" << endl;
    try 
    {
        Queue errorQueue;
        cout << "Попытка извлечения из пустой очереди..." << endl;
        errorQueue.dequeue();
    }
    catch (const runtime_error& e) 
    {
        cout << "Перехвачено исключение: " << e.what() << endl;
    }

    try 
    {
        Queue errorQueue;
        cout << "Попытка просмотра элемента пустой очереди..." << endl;
        errorQueue.peek();
    }
    catch (const runtime_error& e) 
    {
        cout << "Перехвачено исключение: " << e.what() << endl;
    }

    cout << "\nДЕМОНСТРАЦИЯ ЗАВЕРШЕНА" << endl;

    return 0;
}
